# Supabase — copy these from your project's API settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# VAPID keys for Web Push — generate with:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key        # server-side only, NOT prefixed with VITE_
VAPID_EMAIL=mailto:you@youremail.com            # server-side only

# Supabase service-role key (for the /api/notify serverless function — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret — add to Vercel env vars AND vercel.json cron auth header
CRON_SECRET=generate-a-random-string-here
